# Copie para .env e preencha. O .env nunca é commitado.
# Obrigatória com SCRIPT_INTERPRETER=claude (a API não sobe sem ela).
ANTHROPIC_API_KEY=
# Quem interpreta o roteiro: "claude" (real) ou "fake" (testes, sem chamar a API).
SCRIPT_INTERPRETER=claude
# Modelo da Claude usado para interpretar o roteiro.
CLAUDE_SCRIPT_MODEL=claude-opus-5-5
# Pasta onde os projetos são salvos (vazio = pasta data/ na raiz do repo).
DATA_DIR=
